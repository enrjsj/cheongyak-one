# 개발 서버의 /api 프록시 대상. 운영 Vercel에서는 사용하지 않는다.
VITE_API_PROXY_TARGET=http://localhost:8080

# Vercel은 같은 도메인의 /api rewrite를 사용하므로 VITE_API_BASE_URL을 무시한다.
# Vercel 외 환경에서 API를 별도 도메인으로 운영할 때만 지정한다.
# VITE_API_BASE_URL=https://cheongyak-one-api.onrender.com

# 정적 화면 확인 전용이며 공개 테스트 배포에서는 false 또는 미설정으로 둔다.
VITE_DEMO_MODE=false

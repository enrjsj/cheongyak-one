# PostgreSQL production/development connection
DB_URL=jdbc:postgresql://localhost:5432/cheongyak
DB_USERNAME=cheongyak_app
DB_PASSWORD=change-me

# Public API keys: never commit real values
REB_API_KEY=
MYHOME_API_KEY=
MEMBER_MAIL_DELIVERY=log
MEMBER_EMAIL_VERIFICATION_REQUIRED=true
FRONTEND_BASE_URL=http://localhost:5173
MEMBER_MAIL_FROM=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MEMBER_NOTIFICATION_EMAIL_CRON=0 */5 * * * *

# Daily sync, 03:10 Asia/Seoul
NOTICE_SYNC_CRON=0 10 3 * * *

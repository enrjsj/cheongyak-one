# Spring Boot local/production database connection. Supabase production URL에는 sslmode=require를 포함한다.
DB_URL=jdbc:postgresql://localhost:5432/cheongyak
DB_USERNAME=cheongyak_app
DB_PASSWORD=change-me

# Public API keys: never commit real values
REB_API_KEY=
MYHOME_API_KEY=
MEMBER_MAIL_DELIVERY=log
MEMBER_EMAIL_VERIFICATION_REQUIRED=true
FRONTEND_BASE_URL=http://localhost:5173
MEMBER_MAIL_FROM=no-reply@localhost
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MEMBER_NOTIFICATION_EMAIL_CRON=0 */5 * * * *

# Daily sync, 03:10 Asia/Seoul
NOTICE_SYNC_CRON=0 10 3 * * *
NOTICE_SYNC_MAX_ATTEMPTS=3
NOTICE_SYNC_RETRY_DELAY=2s

# GitHub Actions가 Render Free에서 일배치를 호출할 때만 사용한다.
SCHEDULED_NOTICE_SYNC_ENABLED=false
SCHEDULED_NOTICE_SYNC_API_KEY=

# Cross-origin deployment (Vercel -> Render) only
CORS_ALLOWED_ORIGINS=
AUTH_SECURE_COOKIE=false
AUTH_COOKIE_SAME_SITE=Lax
